# RAGFlow Configuration
# Get these values from your RAGFlow instance
RAGFLOW_API_KEY=your_ragflow_api_key_here
RAGFLOW_BASE_URL=http://localhost:9380

# Choose ONE of the following modes:
# Option 1: Chat Assistant mode (recommended for simple use cases)
RAGFLOW_CHAT_ID=your_chat_assistant_id_here

# Option 2: Agent mode (alternative, for complex workflows)
# RAGFLOW_AGENT_ID=your_agent_id_here

# Note: You need either RAGFLOW_CHAT_ID or RAGFLOW_AGENT_ID, not both.
# See RAGFLOW_CHAT_ID_EXPLAINED.md for details.

# Server Configuration
PORT=8000

